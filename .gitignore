# PlatformIO build tree + IDE workspace
.pio/
.vscode/

# Compiled artifacts
*.elf
*.bin
*.pyc
__pycache__/

# Per-kit secrets (BLE PIN, firmware version pin). Template in .env.example.
.env

# Per-kit picker selection (auto-regenerated by `make flash-grove` if missing).
firmware/grove/models/selected.txt

# Cached downloads from `make fetch-grove-firmware` / `make grove-pick`.
firmware/grove/*.img
firmware/grove/sscma-model-we2.json
firmware/grove/models/*.tflite

# Claude Code project instructions and session state (local only).
CLAUDE.md
.claude/

# Editor / OS noise
*~
*.swp
*.swo
.DS_Store
Thumbs.db
